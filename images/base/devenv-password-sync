#!/bin/bash
# Keeps the dev user's password in /etc/shadow in sync with the bcrypt hash
# from the environment Secret (/etc/devenv/ssh/password_hash). No hash means
# the password is locked: SSH keys still work, passwords do not, and sudo
# stays passwordless.
#
#   devenv-password-sync           apply now, then follow the Secret file
#   devenv-password-sync --once    apply the Secret file once
#   devenv-password-sync --stdin   apply the hash read from stdin now
#                                  (pushed by the devenv server so changes
#                                  take effect before the kubelet refreshes
#                                  the Secret volume)
set -u
SRC=/etc/devenv/ssh/password_hash

set_hash() {
  local hash="$1"
  case "$hash" in
    '$2a$'*|'$2b$'*|'$2y$'*) ;;
    *) hash='!' ;;
  esac
  local current
  current=$(getent shadow dev | cut -d: -f2)
  if [ "$current" != "$hash" ]; then
    usermod -p "$hash" dev
    if [ "$hash" = '!' ]; then echo "[devenv] password login disabled"; else echo "[devenv] password updated"; fi
  fi
}

read_file() { [ -r "$SRC" ] && tr -d '\n' < "$SRC"; }

case "${1:-}" in
  --stdin) set_hash "$(tr -d '\n')"; exit 0 ;;
  --once)  set_hash "$(read_file)"; exit 0 ;;
esac

# Apply only when the Secret file changes, so a hash pushed with --stdin is
# not reverted while the volume still holds the previous value.
last=$(read_file)
set_hash "$last"
while sleep 2; do
  cur=$(read_file)
  if [ "$cur" != "$last" ]; then
    last="$cur"
    set_hash "$cur"
  fi
done
